{
    "permissions": {
        "allow": [
            "Bash(awk *)",
            "Bash(grep *)",
            "Bash(grep * | head *)",
            "Bash(grep * | tail *)",
            "Bash(grep * | wc *)",
            "Bash(grep * | grep *)",
            "Bash(grep * | awk *)",
            "Bash(sed *)",
            "Bash(ls)",
            "Bash(ls *)",
            "Bash(ls * 2>/dev/null)",
            "Bash(ls * 2>/dev/null | head *)",
            "Bash(cat *)",
            "Bash(cat * 2>/dev/null)",
            "Bash(cat * 2>/dev/null | head *)",
            "Bash(cat * | grep *)",
            "Bash(echo *)",
            "Bash(echo * 2>/dev/null)",
            "Bash(echo * 2>/dev/null | head *)",
            "Bash(pwd)",
            "Bash(find *)",
            "Bash(find * | head *)",
            "Bash(find * | grep *)",
            "Bash(find * | wc *)",
            "Bash(xargs grep *)",
            "Bash(xargs ls *)",
            "Bash(xargs cat *)",
            "Bash(xargs wc *)",
            "Bash(xargs echo *)",
            "Bash(xargs awk *)",
            "Bash(head *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Bash(sort *)",
            "Bash(uniq *)",
            "Bash(which *)",
            "Bash(cd *)",
            "Bash(mkdir *)",
            "Bash(mktemp*)",
            "Bash(git branch*)",
            "Bash(git log*)",
            "Bash(git log* | head*)",
            "Bash(git log* | tail*)",
            "Bash(git log* | grep*)",
            "Bash(git log* | awk *)",
            "Bash(git log* | jq *)",
            "Bash(git --no-pager log*)",
            "Bash(git diff*)",
            "Bash(git diff* | head*)",
            "Bash(git diff* | tail*)",
            "Bash(git diff* | grep*)",
            "Bash(git diff* | awk *)",
            "Bash(git --no-pager diff*)",
            "Bash(git status*)",
            "Bash(git status* | grep*)",
            "Bash(git status* | awk *)",
            "Bash(git show*)",
            "Bash(git show* | head*)",
            "Bash(git show* | grep*)",
            "Bash(git show* | awk *)",
            "Bash(git show* | jq *)",
            "Bash(git blame*)",
            "Bash(git tag -l*)",
            "Bash(git tag --list*)",
            "Bash(git tag --sort*)",
            "Bash(git checkout*)",
            "Bash(git add*)",
            "Bash(git commit*)",
            "Bash(git merge*)",
            "Bash(git fetch*)",
            "Bash(git rev-parse *)",
            "Bash(git remote -v)",
            "Bash(git remote get-url*)",
            "Bash(git stash*)",
            "Bash(git worktree list)",
            "Bash(git worktree add*)",
            "Bash(git push origin feat*)",
            "Bash(git push origin fix*)",
            "Bash(git push origin refactor*)",
            "Bash(git push -u origin feat*)",
            "Bash(git push -u origin fix*)",
            "Bash(git push -u origin refactor*)",
            "Bash(docker ps*)",
            "Bash(docker ps* | jq *)",
            "Bash(docker version*)",
            "Bash(docker version* | jq *)",
            "WebSearch",
            "Bash(gh issue view*)",
            "Bash(gh issue view* | jq *)",
            "Bash(gh issue list*)",
            "Bash(gh issue list* | jq *)",
            "Bash(gh issue create*)",
            "Bash(gh issue comment*)",
            "Bash(gh label create*)",
            "Bash(gh label list*)",
            "Bash(gh pr view*)",
            "Bash(gh pr view* | jq *)",
            "Bash(gh pr view* | grep*)",
            "Bash(gh pr create*)",
            "Bash(gh pr list*)",
            "Bash(gh pr list* | jq *)",
            "Bash(gh pr diff*)",
            "Bash(gh pr checks*)",
            "Bash(gh pr checks* | grep*)",
            "Bash(gh pr checks* | jq *)",
            "Bash(gh pr ready*)",
            "Bash(gh pr comment*)",
            "Bash(gh pr edit*)",
            "Bash(gh api repos/*)",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:docs.github.com)",
            "WebFetch(domain:raw.githubusercontent.com)",
            "Bash(npm ci)",
            "Bash(npm ci 2>&1 | tail*)",
            "Bash(npm run *)",
            "Bash(npm run * 2>&1 | tail*)",
            "Bash(npm run * | tail*)",
            "Bash(npm run * | head*)",
            "Bash(npm run * | grep*)",
            "Bash(npx tsc *)",
            "Bash(npx eslint *)",
            "Bash(npx prettier *)",
            "Bash(npx jest *)",
            "Bash(npx vitest *)",
            "WebFetch(domain:nodejs.org)",
            "WebFetch(domain:docs.npmjs.com)",
            "WebFetch(domain:www.npmjs.com)",
            "WebFetch(domain:www.typescriptlang.org)"
        ],
        "deny": [
            "Edit(CHANGELOG.md)",
            "Bash(git push origin main)",
            "Bash(git push * origin main*)",
            "Bash(git push *:refs/heads/main*)",
            "Bash(git push * +main*)",
            "Bash(git push *:main*)",
            "Bash(git push * main)",
            "Bash(git push * main *)",
            "Bash(gh api * --method *)",
            "Bash(gh api * -X *)",
            "Edit(**/package-lock.json)",
            "Edit(.release-please-manifest.json)",
            "Bash(gh release create*)",
            "Bash(gh release edit*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-branches.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "F=$(cat | jq -r '.tool_input.file_path'); case \"$F\" in *.ts|*.tsx|*.js|*.mjs|*.cjs) npx eslint --fix \"$F\" 2>/dev/null || true ;; esac; npx prettier --write --ignore-unknown \"$F\" 2>/dev/null || true",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
